# Sao chép thành .env rồi điền khóa. KHÔNG commit .env (đã nằm trong .gitignore).

# --- LLM của Actor: bất kỳ endpoint tương thích OpenAI. Mặc định là Groq (cần GROQ_API_KEY). ---
GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# Endpoint khác (OpenRouter, vLLM tự dựng...): đặt cặp dưới đây; GROQ_* được ưu tiên nếu có cả hai.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# Mô hình của agent (mặc định openai/gpt-oss-120b, cấu hình của số liệu chính). Các mô hình đã chạy trong docs/ket-qua-danh-gia.md:
#   openai/gpt-oss-120b, openai/gpt-oss-20b (Groq) · Qwen/Qwen2.5-7B-Instruct-AWQ, Qwen/Qwen2.5-14B-Instruct-AWQ (vLLM)
# LLM_MODEL=openai/gpt-oss-120b

# Mô hình có ngữ cảnh nhỏ (vLLM max-model-len 8192): hạ token trả lời; model yếu hay lặp nên nâng số bước.
# LLM_MAX_TOKENS=2000
# FINCO_MAX_STEPS=15              # số lần gọi LLM tối đa mỗi lượt (mặc định 15)
# LLM_MAX_DAILY_WAIT=1800         # tối đa giây chờ khi hết hạn mức ngày (HTTP 429)

# Mô hình giám khảo LLM (chỉ dùng bởi eval/judge.py). Nên khác LLM_MODEL để không tự chấm bài của mình.
# JUDGE_MODEL=

# Chế độ truy xuất: hybrid (mặc định) hoặc dense
# RETRIEVAL_MODE=hybrid

# Máy không có mạng sau khi đã tải mô hình embedding:
# HF_HUB_OFFLINE=1

# --- Critic (chốt chặn submit_decision). Code mặc định BẬT (một lần gọi LLM đọc bằng chứng của Actor). ---
# Kết quả A/B (docs/ket-qua-danh-gia.md mục 2.2) chưa thấy critic cải thiện; đặt 0 để tái lập các số liệu "không critic".
# FINCO_CRITIC=0                  # tắt hẳn Critic
# FINCO_CRITIC_MODE=single        # single (mặc định) | agent: critic là agent thứ hai, tự tra cứu bằng tool đọc riêng
# FINCO_CRITIC_MAX_STEPS=6        # số bước tối đa của critic-agent
# Critic dùng model/endpoint KHÁC Actor (giảm lỗi tương quan). Chọn một trong hai:
# FINCO_CRITIC_PROVIDER=gemini    # dùng GEMINI_API_KEY, model mặc định gemini-3.5-flash
# GEMINI_API_KEY=
# FINCO_CRITIC_BASE_URL=          # endpoint OpenAI-compatible bất kỳ, kèm FINCO_CRITIC_API_KEY
# FINCO_CRITIC_API_KEY=
# FINCO_CRITIC_MODEL=             # ghi đè tên model của Critic
