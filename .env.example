# Sao chép thành .env rồi điền khóa. KHÔNG commit .env (đã nằm trong .gitignore).

# Khóa LLM (Groq, tương thích OpenAI). Có thể dùng OPENAI_API_KEY + OPENAI_BASE_URL thay thế.
GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Mô hình của agent (mặc định openai/gpt-oss-20b)
# LLM_MODEL=openai/gpt-oss-20b

# Mô hình giám khảo LLM (chỉ dùng với --judge). Nên khác LLM_MODEL để không tự chấm bài của mình.
# JUDGE_MODEL=

# Chế độ truy xuất: hybrid (mặc định) hoặc dense
# RETRIEVAL_MODE=hybrid

# Máy không có mạng sau khi đã tải mô hình embedding:
# HF_HUB_OFFLINE=1
