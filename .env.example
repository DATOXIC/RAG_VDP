# Sao chép thành .env rồi điền khóa. KHÔNG commit .env (đã nằm trong .gitignore).

# Khóa LLM (Groq, tương thích OpenAI). Có thể dùng OPENAI_API_KEY + OPENAI_BASE_URL thay thế.
GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Mô hình của agent (mặc định openai/gpt-oss-20b)
# LLM_MODEL=openai/gpt-oss-20b

# Mô hình giám khảo LLM (chỉ dùng bởi eval/judge.py). Nên khác LLM_MODEL để không tự chấm bài của mình.
# JUDGE_MODEL=

# Chế độ truy xuất: hybrid (mặc định) hoặc dense
# RETRIEVAL_MODE=hybrid

# Máy không có mạng sau khi đã tải mô hình embedding:
# HF_HUB_OFFLINE=1

# --- Critic (chốt chặn submit_decision). Mặc định bật, một lần gọi LLM đọc bằng chứng của Actor ---
# FINCO_CRITIC=0                  # tắt hẳn Critic
# FINCO_CRITIC_MODE=single        # single (mặc định) | agent: critic là agent thứ hai, tự tra cứu bằng tool đọc riêng
# FINCO_CRITIC_MAX_STEPS=6        # số bước tối đa của critic-agent
# Critic dùng model/endpoint KHÁC Actor (giảm lỗi tương quan). Chọn một trong hai:
# FINCO_CRITIC_PROVIDER=gemini    # dùng GEMINI_API_KEY, model mặc định gemini-3.5-flash
# GEMINI_API_KEY=
# FINCO_CRITIC_BASE_URL=          # endpoint OpenAI-compatible bất kỳ, kèm FINCO_CRITIC_API_KEY
# FINCO_CRITIC_API_KEY=
# FINCO_CRITIC_MODEL=             # ghi đè tên model của Critic
